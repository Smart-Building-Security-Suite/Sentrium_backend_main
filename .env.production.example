# Production Environment Variables for Render
# Copy these to your Render dashboard: Service → Environment

# === REQUIRED SECRETS (Set in Render Dashboard) ===
DATABASE_PASSWORD=npg_l5wxpIHPYBF9
JWT_SECRET=<generate with: openssl rand -base64 64>

# === OPTIONAL SECRETS (If using email features) ===
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# === DATABASE CONFIGURATION ===
DATABASE_URL=jdbc:postgresql://ep-falling-shape-ay6u866f-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner

# === JWT CONFIGURATION ===
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# === HIBERNATE CONFIGURATION ===
# Use 'update' for first deployment, then change to 'validate'
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# === SERVER CONFIGURATION ===
PORT=8080

# === CORS CONFIGURATION ===
# IMPORTANT: Update with your actual frontend URLs
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.render.com,exp://your-expo-app

# === MAIL CONFIGURATION ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# === APPLICATION SETTINGS ===
APP_REPORTS_DIR=/tmp/reports
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
