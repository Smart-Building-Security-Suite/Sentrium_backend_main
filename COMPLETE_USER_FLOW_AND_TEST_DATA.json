            "page": 0,
            "size": 20
          }
        },
        "4e_unlock_door": {
          "method": "POST",
          "endpoint": "/devices/device-uuid-1/unlock",
          "description": "Remotely unlock access point"
        },
        "4f_lock_door": {
          "method": "POST",
          "endpoint": "/devices/device-uuid-1/lock",
          "description": "Remotely lock access point"
        }
