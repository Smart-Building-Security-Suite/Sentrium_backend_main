  "common_query_patterns": {
    "pagination": {
      "page": "Page number (0-indexed)",
      "size": "Items per page (default 20, max 100)",
      "example": "?page=0&size=20"
    },
    "sorting": {
      "sort": "Field and direction",
      "example": "?sort=createdAt,desc"
    },
    "filtering": {
      "devices": "?zoneId=uuid&type=CAMERA_SIM&status=ONLINE&active=true",
      "alerts": "?status=OPEN&severity=CRITICAL&zoneId=uuid&deviceId=uuid",
      "incidents": "?status=OPEN&type=INTRUSION&severity=HIGH&zoneId=uuid",
      "access_logs": "?zoneId=uuid&userId=uuid&deviceId=uuid&result=DENIED"
    },
    "date_ranges": {
      "format": "ISO-8601 date",
      "example": "?from=2026-08-01&to=2026-08-08"
    }
  },
  "testing_script": {
    "description": "Complete end-to-end test script",
    "prerequisites": [
      "Backend running on http://localhost:8080",
      "Database initialized and empty",
      "FFmpeg installed (for video recording)",
      "jq installed (for JSON parsing)"
    ],
    "script_steps": [
      "1. Create admin account via OTP flow",
      "2. Login and save access token",
      "3. Create 3 zones (Main Entrance, Parking Lot, Server Room)",
      "4. Register 5 devices (2 cameras, 2 access points, 1 sensor)",
      "5. Configure all devices with endpoints",
      "6. Send heartbeats to bring devices online",
      "7. Create access rules for zones",
      "8. Log 10 access attempts (7 granted, 3 denied)",
      "9. Register 3 visitors",
      "10. Record 5 motion events",
      "11. Start 2 video recordings",
      "12. Create 8 alerts (various severities)",
      "13. Report 3 incidents",
      "14. Assign and resolve incidents",
      "15. Trigger analytics aggregation",
      "16. Verify all data via list endpoints",
      "17. Test filtering on all endpoints",
      "18. Verify push notification registration",
      "19. Test emergency trigger flow",
      "20. Generate analytics reports"
    ]
  },
  "error_scenarios": {
    "authentication": {
