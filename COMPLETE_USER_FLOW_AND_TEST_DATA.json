  "complete_user_flow": {
    "step_1_authentication": {
      "title": "User Registration and Login",
      "substeps": {
        "1a_request_otp": {
          "method": "POST",
          "endpoint": "/auth/signup/otp/request",
          "description": "Request OTP for new user registration",
          "payload": {
            "phoneNumber": "+1234567890"
          },
          "expected_response": {
            "phoneNumber": "+1234567890",
            "otpSentAt": "2026-08-08T14:00:00Z",
            "expiresIn": 300,
            "otp": "123456"
          },
          "notes": "OTP is returned in response for testing. In production, it would be SMS only."
        },
        "1b_verify_otp": {
          "method": "POST",
          "endpoint": "/auth/signup/otp/verify",
          "description": "Verify OTP and get signup token",
          "payload": {
            "phoneNumber": "+1234567890",
            "otp": "123456"
          },
          "expected_response": {
            "phoneNumber": "+1234567890",
            "signupToken": "uuid-token-here"
          },
          "notes": "Save signupToken for next step"
        },
        "1c_complete_signup": {
          "method": "POST",
          "endpoint": "/auth/signup/complete",
          "description": "Complete signup with user details",
          "payload": {
            "signupToken": "uuid-token-from-step-1b",
            "name": "Admin User",
            "password": "Admin123!",
            "role": "ADMIN"
          },
          "expected_response": {
            "accessToken": "eyJhbGc...",
            "expiresIn": 900,
            "user": {
              "id": "uuid",
              "fullName": "Admin User",
              "phoneNumber": "+1234567890",
              "role": "ADMIN"
            }
          },
          "notes": "Save accessToken for all subsequent requests"
        },
        "1d_login_existing_user": {
          "method": "POST",
          "endpoint": "/auth/login",
          "description": "Login with existing credentials",
          "payload": {
            "phoneNumber": "+1234567890",
            "password": "Admin123!"
          },
          "expected_response": {
            "accessToken": "eyJhbGc...",
            "expiresIn": 900,
            "user": {
              "id": "uuid",
              "fullName": "Admin User",
              "phoneNumber": "+1234567890",
              "role": "ADMIN"
            }
          }
        }
      }
    },
    "step_2_zone_management": {
      "title": "Create and Manage Zones",
      "authentication_required": "Bearer {accessToken}",
      "substeps": {
        "2a_create_main_entrance": {
          "method": "POST",
          "endpoint": "/zones",
          "description": "Create main entrance zone",
          "headers": {
            "Authorization": "Bearer {accessToken}",
            "Content-Type": "application/json"
          },
          "payload": {
            "name": "Main Entrance",
            "description": "Primary building entrance with reception desk",
            "locationX": 0.0,
            "locationY": 0.0
          },
          "expected_response": {
            "id": "zone-uuid-1",
            "name": "Main Entrance",
            "description": "Primary building entrance with reception desk",
            "locationX": 0.0,
            "locationY": 0.0,
            "createdAt": "2026-08-08T14:05:00Z"
          },
          "notes": "Save zone ID for device registration"
        },
        "2b_create_parking_lot": {
          "method": "POST",
          "endpoint": "/zones",
          "payload": {
            "name": "Parking Lot",
            "description": "Outdoor parking area",
            "locationX": 50.0,
            "locationY": 30.0
          }
        },
        "2c_create_server_room": {
          "method": "POST",
          "endpoint": "/zones",
          "payload": {
            "name": "Server Room",
            "description": "Data center and server equipment",
            "locationX": 100.0,
            "locationY": 50.0
          }
        },
        "2d_list_all_zones": {
          "method": "GET",
          "endpoint": "/zones",
          "description": "List all created zones",
          "expected_response": [
            {
              "id": "zone-uuid-1",
              "name": "Main Entrance"
            },
            {
              "id": "zone-uuid-2",
              "name": "Parking Lot"
            }
          ]
        }
      }
    },
    "step_3_device_registration": {
      "title": "Register and Configure Devices",
      "substeps": {
        "3a_register_door_lock": {
          "method": "POST",
          "endpoint": "/devices",
          "description": "Register access control device",
          "payload": {
            "name": "Front Door Lock",
            "type": "ACCESS_POINT",
            "zoneId": "zone-uuid-1"
          },
          "expected_response": {
            "id": "device-uuid-1",
            "name": "Front Door Lock",
            "type": "ACCESS_POINT",
            "status": "OFFLINE",
            "zoneId": "zone-uuid-1",
            "zoneName": "Main Entrance",
            "active": true
          }
        },
        "3b_configure_door_lock": {
          "method": "POST",
          "endpoint": "/devices/device-uuid-1/configure",
          "description": "Configure device connectivity",
          "payload": {
            "endpointUrl": "https://door-controller.local:8443/api",
            "apiKey": "door_api_key_abc123",
            "connectionProtocol": "HTTPS"
          }
        },
        "3c_register_camera": {
          "method": "POST",
          "endpoint": "/devices",
          "description": "Register surveillance camera",
          "payload": {
            "name": "Entrance Camera 01",
            "type": "CAMERA_SIM",
            "zoneId": "zone-uuid-1"
          }
        },
        "3d_configure_camera": {
          "method": "POST",
          "endpoint": "/devices/device-uuid-2/configure",
          "description": "Configure camera with RTSP stream",
          "payload": {
            "endpointUrl": "https://camera-01.local/api",
            "apiKey": "camera_api_key_xyz789",
            "connectionProtocol": "HTTPS",
            "streamUrl": "rtsp://camera-01.local:554/stream1",
            "streamType": "RTSP",
            "streamResolution": "1920x1080",
            "streamFps": 30
          }
        },
        "3e_register_motion_sensor": {
          "method": "POST",
          "endpoint": "/devices",
          "payload": {
            "name": "Motion Sensor - Hallway A",
            "type": "SENSOR",
            "zoneId": "zone-uuid-1"
          }
        },
        "3f_bring_device_online": {
          "method": "POST",
          "endpoint": "/devices/device-uuid-1/heartbeat",
          "description": "Send heartbeat to mark device online",
          "payload": {
            "status": "ONLINE"
          },
          "expected_response": 204
        },
        "3g_list_devices": {
          "method": "GET",
          "endpoint": "/devices",
          "description": "List all devices with filters",
          "query_parameters": {
            "zoneId": "zone-uuid-1",
            "type": "CAMERA_SIM",
            "status": "ONLINE",
            "active": "true"
          }
        }
      }
    },
