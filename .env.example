# Server Configuration
PORT=8080

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,exp://192.168.1.100:8081

# Mail Configuration (optional - for development)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Reports Directory
